# Backend de samawe. El HOST decide el hotel: tiene que estar registrado para
# Crazy Love en `organization_domains` (si no, la API responde 421).
#   local:      http://127.0.0.2:3000   (scripts/seed-dev-domains.ts --slug motel-crazy-love 127.0.0.2)
#   producción: https://api-<crazy-love>.<dominio>
SAMAWE_API_URL=http://127.0.0.2:3000

# Cabecera X-Client-Key del backend (APP_CLIENT_API_KEY). Solo se usa en el
# servidor de Next: nunca llega al navegador.
SAMAWE_API_CLIENT_KEY=
